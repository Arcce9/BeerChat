{
  "name": "app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.14",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:coverage": "jest --selectProjects unit --coverage",
    "test:integration": "jest --selectProjects integration --runInBand --forceExit",
    "test:all": "jest --runInBand --coverage --forceExit",
    "seed:demo": "node scripts/seed-demo.mjs setup",
    "e2e": "maestro test e2e/01-signin-checkin-discover.yaml && node scripts/seed-demo.mjs sam-says-yes && maestro test e2e/02-match-and-chat.yaml"
  },
  "private": true,
  "jest": {
    "testTimeout": 15000,
    "projects": [
      {
        "displayName": "unit",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/__tests__/unit/**/*.test.ts?(x)"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        }
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/__tests__/integration/**/*.test.ts"
        ],
        "transform": {
          "^.+\\.[jt]sx?$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ]
        },
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        }
      }
    ],
    "collectCoverageFrom": [
      "src/lib/**/*.ts",
      "src/components/**/*.tsx",
      "!src/lib/supabase.ts",
      "!src/lib/theme.ts"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 70,
        "functions": 75,
        "lines": 80
      },
      "./src/lib/logic.ts": {
        "statements": 95,
        "branches": 90,
        "functions": 100,
        "lines": 95
      }
    }
  }
}
